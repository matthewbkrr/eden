# The directory Mix will write compiled artifacts to.
/_build/

# If you run "mix test --cover", coverage assets end up here.
/cover/

# The directory Mix downloads your dependencies sources to.
/deps/

# Where 3rd-party dependencies like ExDoc output generated docs.
/doc/

# Ignore .fetch files in case you like to edit your project deps locally.
/.fetch

# If the VM crashes, it generates a dump, let's ignore it too.
erl_crash.dump

# Also ignore archive artifacts (built via "mix archive.build").
*.ez

# Temporary files, for example, from tests.
/tmp/

# Ignore package tarball (built via "mix hex.build").
eden-*.tar

# Ignore assets that are produced by build tools.
/priv/static/assets/

# Ignore digested assets cache.
/priv/static/cache_manifest.json

# In case you use Node.js/npm, you want to ignore these.
npm-debug.log
/assets/node_modules/

# Dialyzer PLT files (build artifacts; cached separately in CI).
/priv/plts/

# Local-disk uploads (dev storage adapter).
/priv/uploads/


# Deploy secrets — never commit a filled .env (the example is tracked) or DB dumps.
.env
.env.*
!.env.example
/deploy/.env
/deploy/backups/

# graphify knowledge-graph tooling output (local, not part of the app).
/graphify-out/

# Local scratch / debug artifacts (never part of the app).
/test/e2e/scratch/
/.impeccable/

# Handbook build artifacts (docs/handbook/README.md) — HTML sources are tracked,
# screenshots/PDFs/seed-output are regenerated locally.
/docs/handbook/shots/
/docs/handbook/dist/
/docs/handbook/.demo.json

# `mix phx.digest` writes a fingerprinted copy NEXT TO each original (the originals themselves are
# tracked), plus .gz siblings. Matching the 32-hex digest shape rather than "anything with a
# hyphen" so `favicon-32x32.png` stays tracked. One pattern covers both depths: a middle `/**/`
# matches ZERO or more directories, so this also catches files sitting directly in priv/static
# (verified with `git check-ignore` on both).
/priv/static/**/*-[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f].*
/priv/static/**/*.gz
